[Unit]
Description=Ansible Pull Service
Documentation=https://docs.ansible.com/
After=network-online.target start-hotspot.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/tmp
ExecStart=/usr/local/bin/ansible-pull-wrapper.sh
# append:, not file:. systemd's file: opens the log without truncating it, so
# a run that produces less output than the one before leaves the tail of the
# older run behind and the log reads as two runs spliced together - with stale
# timestamps and lines from scripts that no longer exist. The wrapper truncates
# the log itself at the start of each run, so one file is exactly one run.
StandardOutput=append:/mnt/data/ansible-pull.log
StandardError=append:/mnt/data/ansible-pull.log
TimeoutSec=infinity
# Performance optimizations
Environment="ANSIBLE_PIPELINING=True"
Environment="ANSIBLE_FORKS=20"
Environment="ANSIBLE_GATHERING=smart"

[Install]
WantedBy=multi-user.target